# =====================================================================
# LISSCOMPANY — exemplo de configuração de ambiente (sem segredos reais)
# Copie para .env (não versionado) e preencha por ambiente.
# Os dados bancários e o número Multicaixa Express NÃO ficam aqui:
# são configuração privada, editável no painel administrativo.
# =====================================================================

# ---------- Backend (Spring Boot) ----------
# Porta da API
SERVER_PORT=8080

# PostgreSQL — base de dados de produção/desenvolvimento
DB_URL=jdbc:postgresql://localhost:5432/lisscompany
DB_USERNAME=lisscompany
DB_PASSWORD=

# Origens do frontend autorizadas (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Perfis Spring: «demo» acrescenta o catálogo ILUSTRATIVO (preços fictícios) —
# só para desenvolvimento; «prod» fecha a documentação da API e exige cookies seguros.
# SPRING_PROFILES_ACTIVE=demo

# Cookies de sessão: true em HTTPS (produção)
COOKIE_SECURE=false

# Documentação OpenAPI pública (false em produção)
DOCS_PUBLIC=true

# Pasta das fotografias carregadas no painel (usar volume persistente)
MEDIA_DIR=./data/media

# URL público do site (links de recuperação de palavra-passe)
PUBLIC_BASE_URL=http://localhost:3000

# APENAS desenvolvimento: escreve o link de recuperação de palavra-passe no log
# (em produção o canal de e-mail/SMS é uma decisão pendente da proprietária)
DEV_LOG_RESET_LINKS=false

# ---------- Frontend (Vite) ----------
# Prefixo VITE_ é exposto ao browser — NUNCA coloque aqui segredos.
VITE_API_BASE_URL=/api/v1

# Apenas para desenvolvimento local: alvo do proxy do Vite para o backend.
# Em produção o frontend fala com a API pelo mesmo domínio (ou proxy equivalente).
VITE_API_PROXY_TARGET=http://localhost:8080
