# =====================================================================
# LISSCOMPANY — exemplo de configuração de ambiente (sem segredos reais)
# Copie para .env (não versionado) e preencha por ambiente.
# Os dados bancários e o número Multicaixa Express NÃO ficam aqui:
# são configuração privada, editável no painel administrativo.
# =====================================================================

# ---------- Backend (Spring Boot) ----------
# Porta da API
SERVER_PORT=8080

# PostgreSQL — base de dados de produção/desenvolvimento
DB_URL=jdbc:postgresql://localhost:5432/lisscompany
DB_USERNAME=lisscompany
DB_PASSWORD=

# Origens do frontend autorizadas (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------- Frontend (Vite) ----------
# Prefixo VITE_ é exposto ao browser — NUNCA coloque aqui segredos.
VITE_API_BASE_URL=/api/v1

# Apenas para desenvolvimento local: alvo do proxy do Vite para o backend.
# Em produção o frontend fala com a API pelo mesmo domínio (ou proxy equivalente).
VITE_API_PROXY_TARGET=http://localhost:8080
